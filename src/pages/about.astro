---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides residential and commercial ${serviceKeyword} in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} provides house washing, concrete cleaning, and deck and fence cleaning in Florence, Covington, Fort Thomas, Newport, and across Northern Kentucky. What we do, how a job works, and where we go.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Pressure washing and soft washing for Northern Kentucky homes and businesses.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Pressure washing crew with hoses and a surface cleaner"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>Exterior cleaning in Boone, Kenton, and Campbell counties: soft wash house washing, driveway and concrete cleaning, and deck and fence cleaning for homes, plus storefronts, sidewalks, and commercial buildings.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Quote.</strong> Call {phone} or send the form. Tell us which surfaces you want cleaned, roughly how big they are, and anything unusual — heavy mold on a north wall, oil stains, a deck you plan to seal, or delicate plantings close to the house.</p>

  <p><strong>2. Cleaning.</strong> Siding, painted wood, and roofs are soft washed at low pressure with a diluted cleaning solution. Concrete is cleaned at higher pressure with a surface cleaner. Plants near the work area are wet down first and rinsed afterward. See the <a href="/guides/pre-treating-mold-on-vinyl-siding/">soft washing guide</a> for how siding pre-treatment works.</p>

  <p><strong>3. Walk-through.</strong> Before the crew leaves, look the work over with them. Anything missed gets touched up on the spot.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/pressure-washing/${c.slug}/`}>Pressure washing in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Transform Your Home's Exterior?</p>
    <p class="cta-sub">Call now for a free estimate.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
